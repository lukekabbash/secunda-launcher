<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime exceptions for the Wine loader only. Each one was
         found by running a Developer ID signed runtime; the launcher itself
         carries none of them. -->

    <!-- Windows code is mapped writable and executable. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Without this a Developer ID signed Wine never finishes starting:
         wineboot spins forever on a fresh prefix. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The launcher points Wine at the bundled libraries with
         DYLD_LIBRARY_PATH, which the hardened runtime otherwise discards. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Games open the microphone for voice chat at startup. Under the
         hardened runtime the process is denied without this, and titles
         such as Black Ops II exit. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
