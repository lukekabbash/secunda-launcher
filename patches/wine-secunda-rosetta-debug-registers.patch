+    return TRUE;
+#else
+    return FALSE;
+#endif
+}
+
+static BOOL is_relayed_debug_trap( ucontext_t *ucontext, CONTEXT *context )
+{
+#ifdef __APPLE__
+    if (TRAP_sig(ucontext) != 0xde) return FALSE;
+    if (!get_relayed_debug_registers( context )) return FALSE;
+    return !!(context->Dr6 & 0xf);
+#endif
+    return FALSE;
+}
