+#ifdef __APPLE__
+/***********************************************************************
+ *           trace_i386_exception_stack
+ *
+ * Emit a bounded stack snapshot for 32-bit faults translated by Rosetta.
+ */
+static void trace_i386_exception_stack( const EXCEPTION_RECORD *rec, const CONTEXT *context )
+{
+    DWORD words[512];
+    const void *snapshot;
+    SIZE_T bytes, count;
+    unsigned int i;
+
+    if (!trace_i386_exception_stacks || context->SegCs != cs32_sel ||
+        rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION)
+        return;
+
+    /* Keep the read on the faulting stack page. A large snapshot can cross the
+     * stack allocation boundary and make an otherwise readable continuation
+     * look empty. Aligning down preserves the words around the current guest
+     * stack pointer. */
+    snapshot = (const void *)(ULONG_PTR)((DWORD)context->Rsp & ~15u);
+    bytes = virtual_uninterrupted_read_memory( snapshot, words, sizeof(words) );
+    count = bytes / sizeof(*words);
+    TRACE_(seh)( "i386 exception stack eip=%08x esp=%08x snapshot=%p bytes=%lu\n",
+                 (DWORD)context->Rip, (DWORD)context->Rsp, snapshot, bytes );
+
+    for (i = 0; i < count; i += 4)
+    {
+        if (count - i >= 4)
+            TRACE_(seh)( " stack[%03u]=%08x %08x %08x %08x\n", i,
+                         words[i], words[i + 1], words[i + 2], words[i + 3] );
+        else if (count - i == 3)
+            TRACE_(seh)( " stack[%03u]=%08x %08x %08x\n", i,
+                         words[i], words[i + 1], words[i + 2] );
+        else if (count - i == 2)
+            TRACE_(seh)( " stack[%03u]=%08x %08x\n", i, words[i], words[i + 1] );
+        else
+            TRACE_(seh)( " stack[%03u]=%08x\n", i, words[i] );
+    }
+}
+#endif
