+static void stop_debug_broker(void)
+{
+    if (debug_broker_pid == -1) return;
+    kill( debug_broker_pid, SIGTERM );
+    waitpid( debug_broker_pid, NULL, 0 );
+    debug_broker_pid = -1;
+}
+
+static char *get_debug_broker_path(void)
+{
+    static const char helper_name[] = "secunda-rosetta-debug-broker";
+    char *path, *name;
+
+    if (!(path = realpath( server_argv0, NULL ))) return NULL;
+    if (!(name = strrchr( path, '/' )))
+    {
+        free( path );
+        return NULL;
+    }
+    if ((size_t)(name - path) + sizeof(helper_name) > PATH_MAX)
+    {
+        free( path );
+        return NULL;
+    }
+    strcpy( name + 1, helper_name );
+    return path;
+}
+
+static int receive_debug_broker_hello(void)
+{
+    struct
+    {
+        struct secunda_debug_hello hello;
+        mach_msg_trailer_t trailer;
+    } message;
+    kern_return_t result;
+
+    memset( &message, 0, sizeof(message) );
+    result = mach_msg( &message.hello.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT,
+                       0, sizeof(message), server_mach_port, 2000, MACH_PORT_NULL );
+    if (result != KERN_SUCCESS) return 0;
+    if (message.hello.header.msgh_id != SECUNDA_DEBUG_HELLO_ID ||
+        message.hello.magic != SECUNDA_DEBUG_MAGIC ||
+        message.hello.body.msgh_descriptor_count != 1 ||
+        message.hello.command_port.type != MACH_MSG_PORT_DESCRIPTOR ||
+        message.hello.command_port.name == MACH_PORT_NULL)
+        return 0;
+    debug_broker_port = message.hello.command_port.name;
+    return 1;
+}
+
+static void start_debug_broker(void)
+{
+    char *path;
+
+    if (!is_rosetta() || !(path = get_debug_broker_path())) return;
+    if (access( path, X_OK ))
+    {
+        free( path );
+        return;
+    }
+    if (!(debug_broker_pid = fork()))
+    {
+        execl( path, path, debug_broker_service, NULL );
+        _exit( 127 );
+    }
+    free( path );
+    if (debug_broker_pid == -1 || !receive_debug_broker_hello())
+    {
+        if (debug_broker_pid != -1) stop_debug_broker();
+        if (debug_level) fprintf( stderr, "warning: native debug-register relay unavailable\n" );
+        return;
+    }
+    atexit( stop_debug_broker );
+}
+
+static kern_return_t call_debug_broker( struct thread *thread, mach_msg_id_t message_id,
+                                        unsigned short machine,
+                                        struct secunda_debug_registers *registers )
+{
+    struct secunda_debug_command command;
+    struct
+    {
+        struct secunda_debug_reply reply;
+        mach_msg_trailer_t trailer;
+    } response;
+    mach_msg_type_name_t type;
+    mach_port_t process_port = get_process_port( thread->process );
+    mach_port_t reply_port, thread_port;
+    kern_return_t result;
+
+    if (!debug_broker_port) return KERN_NOT_SUPPORTED;
+    if (thread->unix_pid == -1 || !process_port ||
+        mach_port_extract_right( process_port, thread->unix_tid,
+                                 MACH_MSG_TYPE_COPY_SEND, &thread_port, &type ))
+        return KERN_PROTECTION_FAILURE;
+    if ((result = mach_port_allocate( mach_task_self(), MACH_PORT_RIGHT_RECEIVE,
+                                      &reply_port )) != KERN_SUCCESS)
+    {
+        mach_port_deallocate( mach_task_self(), thread_port );
+        return result;
+    }
+
+    memset( &command, 0, sizeof(command) );
+    command.header.msgh_bits = MACH_MSGH_BITS_COMPLEX |
+        MACH_MSGH_BITS( MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND_ONCE );
+    command.header.msgh_size = sizeof(command);
+    command.header.msgh_remote_port = debug_broker_port;
+    command.header.msgh_local_port = reply_port;
+    command.header.msgh_id = message_id;
+    command.body.msgh_descriptor_count = 1;
+    command.thread_port.name = thread_port;
+    command.thread_port.disposition = MACH_MSG_TYPE_MOVE_SEND;
+    command.thread_port.type = MACH_MSG_PORT_DESCRIPTOR;
+    command.magic = SECUNDA_DEBUG_MAGIC;
+    command.thread_id = get_thread_id( thread );
+    command.unix_pid = thread->unix_pid;
+    command.unix_tid = thread->unix_tid;
+    command.machine = machine;
+    command.registers = *registers;
 
+    result = mach_msg( &command.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT,
+                       sizeof(command), 0, MACH_PORT_NULL, 1000, MACH_PORT_NULL );
+    if (result != KERN_SUCCESS)
+    {
+        mach_port_deallocate( mach_task_self(), thread_port );
+        goto done;
+    }
+    memset( &response, 0, sizeof(response) );
+    result = mach_msg( &response.reply.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT,
+                       0, sizeof(response), reply_port, 1000, MACH_PORT_NULL );
+    if (result == KERN_SUCCESS)
+    {
+        if (response.reply.header.msgh_id != SECUNDA_DEBUG_REPLY_ID ||
+            response.reply.magic != SECUNDA_DEBUG_MAGIC)
+            result = KERN_INVALID_ARGUMENT;
+        else
+        {
+            result = response.reply.status;
+            if (result == KERN_SUCCESS) *registers = response.reply.registers;
+        }
+    }
+done:
+    mach_port_deallocate( mach_task_self(), reply_port );
+    return result;
+}
