+static BOOL i386_execute_breakpoint_enabled( const I386_CONTEXT *context, unsigned int index )
+{
+    return (context->Dr7 & (3u << (index * 2))) &&
+           !((context->Dr7 >> (16 + index * 4)) & 3);
+}
+
+static BOOL i386_data_breakpoint_hit_values( ULONG64 dr6, ULONG64 dr7 )
+{
+    unsigned int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        if (!(dr6 & ((ULONG64)1 << i))) continue;
+        if (!(dr7 & ((ULONG64)3 << (i * 2)))) continue;
+        if ((dr7 >> (16 + i * 4)) & 3) return TRUE;
+    }
+    return FALSE;
+}
