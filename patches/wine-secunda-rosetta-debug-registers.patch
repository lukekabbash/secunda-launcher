+static BOOL emulate_i386_protected_hash_tail( ucontext_t *ucontext,
+                                              const EXCEPTION_RECORD *rec,
+                                              const CONTEXT *context )
+{
+    const DWORD zombies_tail_copy = 0x00a6c944;
+    const DWORD multiplayer_tail_copy = 0x00a72d34;
+    const DWORD smoke_tail_copy = 0x10030000;
+    const BYTE expected_instruction[] = {0x8b, 0x44, 0x8e, 0xfc};
+    DWORD source_address, destination_address, value;
+    int source_protection, destination_protection;
+    BYTE instruction[ARRAY_SIZE(expected_instruction)];
+
+    source_address = (DWORD)context->Rsi + (DWORD)context->Rcx * sizeof(DWORD) -
+                     sizeof(DWORD);
+    destination_address = (DWORD)context->Rdi +
+                          (DWORD)context->Rcx * sizeof(DWORD) - sizeof(DWORD);
+    if (!emulate_i386_protected_hash_copy_reads || !is_rosetta2 ||
+        context->SegCs != cs32_sel ||
+        !((DWORD)context->Rip == zombies_tail_copy ||
+          (DWORD)context->Rip == multiplayer_tail_copy ||
+          (emulate_i386_protected_hash_copy_smoke &&
+           (DWORD)context->Rip == smoke_tail_copy)) ||
+        (DWORD)context->Rcx != 1 ||
+        i386_protected_hash_copy_page != i386_execute_page( source_address ) ||
+        rec->ExceptionInformation[0] != EXCEPTION_READ_FAULT ||
+        (DWORD)rec->ExceptionInformation[1] != source_address ||
+        (context->EFlags & 0x400) ||
+        virtual_uninterrupted_read_memory( (const void *)(ULONG_PTR)context->Rip,
+                                           instruction, sizeof(instruction) )
+            != sizeof(instruction) ||
+        memcmp( instruction, expected_instruction, sizeof(instruction) ) ||
+        !query_i386_execute_page_protection( destination_address,
+                                             &destination_protection ) ||
+        !(destination_protection & PROT_WRITE) ||
+        !read_i386_protected_hash_memory( source_address, &value, sizeof(value),
+                                          &source_protection ))
+        return FALSE;
+
+    RAX_sig(ucontext) = value;
+    RIP_sig(ucontext) += sizeof(instruction);
+    i386_protected_hash_copy_page = 0;
+    if (trace_i386_protected_transform)
+        fprintf( stderr,
+                 "SECUNDA_PROTECTED_COPY_EMULATED tid=%p phase=tail eip=%08x "
+                 "source=%08x destination=%08x bytes=%lu source_protection=%x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, (DWORD)context->Rip,
+                 source_address, destination_address, (unsigned long)sizeof(value),
+                 source_protection );
+    return TRUE;
+}
+
+/* A translated protected-code check copies bounded hash blocks from a
+   temporarily inaccessible page. Preserve the guest instruction's exact
+   register semantics without widening access beyond each individual copy. */
+static BOOL emulate_i386_protected_hash_copy( ucontext_t *ucontext,
+                                              const EXCEPTION_RECORD *rec,
+                                              const CONTEXT *context )
+{
+    const DWORD zombies_initial_copy = 0x00a6c847;
+    const DWORD multiplayer_initial_copy = 0x00a72c37;
+    const DWORD zombies_block_copy = 0x0041515f;
+    const DWORD multiplayer_block_copy = 0x0050d81f;
+    const DWORD smoke_initial_copy = 0x10010000;
+    const DWORD smoke_block_copy = 0x10020000;
+    DWORD_PTR source_page;
+    SIZE_T dword_count, copy_size;
+    BOOL initial_copy, block_copy;
+    BYTE instruction[2];
+    DWORD copy[16];
+    int source_protection, destination_protection;
+    NTSTATUS status;
+
+    if (emulate_i386_protected_hash_tail( ucontext, rec, context )) return TRUE;
+
+    dword_count = (DWORD)context->Rcx;
+    copy_size = dword_count * sizeof(DWORD);
+    source_page = i386_execute_page( context->Rsi );
+    initial_copy = ((DWORD)context->Rip == zombies_initial_copy ||
+                    (DWORD)context->Rip == multiplayer_initial_copy ||
+                    (emulate_i386_protected_hash_copy_smoke &&
+                     (DWORD)context->Rip == smoke_initial_copy)) &&
+                   dword_count == 15;
+    block_copy = ((DWORD)context->Rip == zombies_block_copy ||
+                  (DWORD)context->Rip == multiplayer_block_copy ||
+                  (emulate_i386_protected_hash_copy_smoke &&
+                   (DWORD)context->Rip == smoke_block_copy)) &&
+                 dword_count == ARRAY_SIZE(copy) &&
+                 i386_protected_hash_copy_page == source_page;
+
+    if (!emulate_i386_protected_hash_copy_reads || !is_rosetta2 ||
+        context->SegCs != cs32_sel ||
+        (!initial_copy && !block_copy) ||
+        rec->ExceptionInformation[0] != EXCEPTION_READ_FAULT ||
+        (DWORD)rec->ExceptionInformation[1] != (DWORD)context->Rsi ||
+        (context->EFlags & 0x400) ||
+        virtual_uninterrupted_read_memory( (const void *)(ULONG_PTR)context->Rip,
+                                           instruction, sizeof(instruction) )
+            != sizeof(instruction) ||
+        instruction[0] != 0xf3 || instruction[1] != 0xa5 ||
+        !query_i386_execute_page_protection( context->Rdi, &destination_protection ) ||
+        !(destination_protection & PROT_WRITE) ||
+        !read_i386_protected_hash_memory( (DWORD)context->Rsi, copy, copy_size,
+                                          &source_protection ))
+        return FALSE;
+
+    status = virtual_uninterrupted_write_memory(
+        (void *)(ULONG_PTR)context->Rdi, copy, copy_size );
+    if (status) return FALSE;
+
+    RIP_sig(ucontext) += sizeof(instruction);
+    RSI_sig(ucontext) += copy_size;
+    RDI_sig(ucontext) += copy_size;
+    RCX_sig(ucontext) = 0;
+    if (initial_copy) i386_protected_hash_copy_page = source_page;
+    if (trace_i386_protected_transform)
+        fprintf( stderr,
+                 "SECUNDA_PROTECTED_COPY_EMULATED tid=%p phase=%s eip=%08x "
+                 "source=%08x destination=%08x bytes=%lu source_protection=%x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread,
+                 initial_copy ? "initial" : "block", (DWORD)context->Rip,
+                 (DWORD)context->Rsi,
+                 (DWORD)context->Rdi,
+                 (unsigned long)copy_size, source_protection );
+    return TRUE;
+}
+
+static int i386_execute_guard_protection( int protection )
+{
+    int guarded = protection & ~PROT_EXEC;
+
+    /* A translated hardware breakpoint must not make the guarded code page
+       unreadable to another thread while execution remains suppressed. */
+    if (preserve_i386_guarded_execute_reads) guarded |= PROT_READ;
+    return guarded;
+}
+
+#define I386_EXECUTE_PAGE_GUARD_COUNT 256
+#define I386_EXECUTE_PAGE_OWNER_COUNT 16
+
+struct i386_execute_page_owner
+{
+    const TEB *teb;
+    mach_port_t thread;
+    unsigned int references;
+};
+
+struct i386_execute_page_guard
+{
+    DWORD_PTR page;
+    int protection;
+    unsigned int references;
+    struct i386_execute_page_owner owners[I386_EXECUTE_PAGE_OWNER_COUNT];
+};
+
+static struct i386_execute_page_guard i386_execute_page_guards[I386_EXECUTE_PAGE_GUARD_COUNT];
+static volatile LONG i386_execute_page_guard_lock;
+static __thread mach_port_t i386_suspended_execute_owners[I386_EXECUTE_PAGE_OWNER_COUNT];
+static __thread unsigned int i386_suspended_execute_owner_count;
+
+enum i386_execute_page_owner_state
+{
+    I386_EXECUTE_PAGE_NOT_FOUND,
+    I386_EXECUTE_PAGE_OWNERS_ACTIVE,
+    I386_EXECUTE_PAGE_OWNERS_RETIRED
+};
+
+static void lock_i386_execute_page_guards( void )
+{
+    while (InterlockedCompareExchange( &i386_execute_page_guard_lock, 1, 0 ))
+        __asm__ __volatile__( "pause" );
+}
+
+static void unlock_i386_execute_page_guards( void )
+{
+    InterlockedExchange( &i386_execute_page_guard_lock, 0 );
+}
+
+static void discard_dead_i386_execute_page_owners(
+    struct i386_execute_page_guard *guard )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(guard->owners); ++i)
+    {
+        struct i386_execute_page_owner *owner = &guard->owners[i];
+        mach_port_type_t type;
+
+        if (!owner->teb ||
+            (mach_port_type( mach_task_self(), owner->thread, &type ) == KERN_SUCCESS &&
+             !(type & MACH_PORT_TYPE_DEAD_NAME)))
+            continue;
+        guard->references -= owner->references;
+        memset( owner, 0, sizeof(*owner) );
+    }
+}
+
+static BOOL get_i386_execute_page_guard( DWORD_PTR address, int *protection )
+{
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i;
+    BOOL found = FALSE;
+
+    lock_i386_execute_page_guards();
+    for (i = 0; i < ARRAY_SIZE(i386_execute_page_guards); ++i)
+    {
+        const struct i386_execute_page_guard *guard = &i386_execute_page_guards[i];
+
+        if (guard->page != page) continue;
+        *protection = guard->protection;
+        found = TRUE;
+        break;
+    }
+    unlock_i386_execute_page_guards();
+    return found;
+}
+
+static void arm_shared_i386_execute_page_guard( DWORD_PTR address )
+{
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i;
+
+    lock_i386_execute_page_guards();
+    for (i = 0; i < ARRAY_SIZE(i386_execute_page_guards); ++i)
+    {
+        const struct i386_execute_page_guard *guard = &i386_execute_page_guards[i];
+
+        if (guard->page != page) continue;
+        if (guard->references > 1)
+            set_i386_execute_page_protection(
+                address, i386_execute_guard_protection( guard->protection ) );
+        break;
+    }
+    unlock_i386_execute_page_guards();
+}
+
+static BOOL retain_i386_execute_page( DWORD_PTR address, int *protection )
+{
+    struct i386_execute_page_guard *available = NULL;
+    struct i386_execute_page_owner *available_owner;
+    DWORD_PTR page = i386_execute_page( address );
+    const TEB *owner = NtCurrentTeb();
+    mach_port_t owner_thread = pthread_mach_thread_np( pthread_self() );
+    unsigned int i, j;
+    BOOL retained = FALSE;
+
+    lock_i386_execute_page_guards();
+    for (i = 0; i < ARRAY_SIZE(i386_execute_page_guards); ++i)
+    {
+        struct i386_execute_page_guard *guard = &i386_execute_page_guards[i];
+
+        if (guard->page == page)
+        {
+            if (!set_i386_execute_page_protection(
+                    address, i386_execute_guard_protection( guard->protection ) ))
+                goto done;
+            discard_dead_i386_execute_page_owners( guard );
+            available_owner = NULL;
+            for (j = 0; j < ARRAY_SIZE(guard->owners); ++j)
+            {
+                struct i386_execute_page_owner *entry = &guard->owners[j];
+
+                if (entry->teb == owner)
+                {
+                    entry->references++;
+                    break;
+                }
+                if (!entry->teb && !available_owner) available_owner = entry;
+            }
+            if (j == ARRAY_SIZE(guard->owners))
+            {
+                if (!available_owner)
+                {
+                    WARN_(seh)( "Rosetta x86 execute-breakpoint page %p owner table is full\n",
+                                (void *)page );
+                    goto done;
+                }
+                available_owner->teb = owner;
+                available_owner->thread = owner_thread;
+                available_owner->references = 1;
+            }
+            guard->references++;
+            *protection = guard->protection;
+            retained = TRUE;
+            goto done;
+        }
+        if (!guard->page && !available) available = guard;
+    }
+
+    if (available && query_i386_execute_page_protection( address, protection ) &&
+        (*protection & PROT_EXEC) &&
+        set_i386_execute_page_protection(
+            address, i386_execute_guard_protection( *protection ) ))
+    {
+        if (trace_i386_protected_transform)
+            fprintf( stderr,
+                     "SECUNDA_PROTECTED_GUARD address=%08x page=%08x "
+                     "original=%x guarded=%x\n", (DWORD)address, (DWORD)page,
+                     *protection, i386_execute_guard_protection( *protection ) );
+        available->page = page;
+        available->protection = *protection;
+        available->references = 1;
+        available->owners[0].teb = owner;
+        available->owners[0].thread = owner_thread;
+        available->owners[0].references = 1;
+        retained = TRUE;
+    }
+
+done:
+    unlock_i386_execute_page_guards();
+    if (!retained && !available)
+        WARN_(seh)( "Rosetta x86 execute-breakpoint page table is full\n" );
+    return retained;
+}
+
+static void release_i386_execute_page( DWORD_PTR address, const TEB *owner )
+{
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i, j;
+
+    lock_i386_execute_page_guards();
+    for (i = 0; i < ARRAY_SIZE(i386_execute_page_guards); ++i)
+    {
+        struct i386_execute_page_guard *guard = &i386_execute_page_guards[i];
+
+        if (guard->page != page) continue;
+        for (j = 0; j < ARRAY_SIZE(guard->owners); ++j)
+        {
+            struct i386_execute_page_owner *entry = &guard->owners[j];
+
+            if (entry->teb != owner) continue;
+            if (!--entry->references) memset( entry, 0, sizeof(*entry) );
+            break;
+        }
+        if (j == ARRAY_SIZE(guard->owners))
+        {
+            WARN_(seh)( "Rosetta x86 execute-breakpoint page %p owner %p not found\n",
+                        (void *)page, owner );
+            break;
+        }
+        if (--guard->references) break;
+        if (set_i386_execute_page_protection( page, guard->protection ))
+        {
+            memset( guard, 0, sizeof(*guard) );
+        }
+        break;
+    }
+    unlock_i386_execute_page_guards();
+}
+
+static void arm_i386_execute_entry_observer( void )
+{
+    DWORD_PTR address;
+    int protection;
+
+    if (!trace_i386_execute_entry_count ||
+        InterlockedCompareExchange( &i386_execute_entry_state, -1, 0 ))
+        return;
+    address = trace_i386_execute_entries[0];
+    if (!retain_i386_execute_page( address, &protection ))
+    {
+        InterlockedExchange( &i386_execute_entry_state, 0 );
+        return;
+    }
+
+    i386_execute_entry_owner = NtCurrentTeb();
+    InterlockedExchange( &i386_execute_entry_state, 1 );
+    ERR_(seh)( "SECUNDA_EXECUTE_ENTRY_ARMED address=%08x page=%08x "
+               "targets=%u owner=%p protection=%x\n", (DWORD)address,
+               (DWORD)i386_execute_page( address ),
+               trace_i386_execute_entry_count, i386_execute_entry_owner,
+               protection );
+}
+
+static BOOL capture_i386_execute_entry( ucontext_t *ucontext, DWORD_PTR address )
+{
+    BYTE instruction[16] = {0};
+    DWORD stack[12] = {0};
+    SIZE_T instruction_bytes, stack_bytes;
+    unsigned int i, stack_words;
+    const TEB *owner;
+    BOOL matches = FALSE;
+
+    for (i = 0; i < trace_i386_execute_entry_count; ++i)
+        if (address == trace_i386_execute_entries[i]) matches = TRUE;
+    if (!matches ||
+        InterlockedCompareExchange( &i386_execute_entry_state, 2, 1 ) != 1)
+        return FALSE;
+
+    instruction_bytes = virtual_uninterrupted_read_memory(
+        (const void *)(ULONG_PTR)address, instruction, sizeof(instruction) );
+    stack_bytes = virtual_uninterrupted_read_memory(
+        (const void *)(ULONG_PTR)RSP_sig(ucontext), stack, sizeof(stack) );
+    stack_words = stack_bytes / sizeof(*stack);
+    ERR_(seh)( "SECUNDA_EXECUTE_ENTRY_CONTEXT eip=%08x esp=%08x ebp=%08x "
+               "eax=%08x ebx=%08x ecx=%08x edx=%08x esi=%08x edi=%08x "
+               "return=%08x instruction_bytes=%lu stack_bytes=%lu "
+               "instruction=%02x%02x%02x%02x%02x%02x%02x%02x"
+               "%02x%02x%02x%02x%02x%02x%02x%02x\n",
+               (DWORD)address, (DWORD)RSP_sig(ucontext),
+               (DWORD)RBP_sig(ucontext), (DWORD)RAX_sig(ucontext),
+               (DWORD)RBX_sig(ucontext), (DWORD)RCX_sig(ucontext),
+               (DWORD)RDX_sig(ucontext), (DWORD)RSI_sig(ucontext),
+               (DWORD)RDI_sig(ucontext), stack_words ? stack[0] : 0,
+               (unsigned long)instruction_bytes, (unsigned long)stack_bytes,
+               instruction[0], instruction[1], instruction[2], instruction[3],
+               instruction[4], instruction[5], instruction[6], instruction[7],
+               instruction[8], instruction[9], instruction[10], instruction[11],
+               instruction[12], instruction[13], instruction[14], instruction[15] );
+    for (i = 0; i < stack_words; i += 4)
+    {
+        ERR_(seh)( "SECUNDA_EXECUTE_ENTRY_STACK index=%u "
+                   "values=%08x,%08x,%08x,%08x\n", i, stack[i],
+                   i + 1 < stack_words ? stack[i + 1] : 0,
+                   i + 2 < stack_words ? stack[i + 2] : 0,
+                   i + 3 < stack_words ? stack[i + 3] : 0 );
+    }
+
+    owner = i386_execute_entry_owner;
+    i386_execute_entry_owner = NULL;
+    if (owner) release_i386_execute_page( trace_i386_execute_entries[0], owner );
+    return TRUE;
+}
+
+static mach_port_t resume_i386_execute_page_owners( void )
+{
+    mach_port_t preferred = MACH_PORT_NULL;
+
+    while (i386_suspended_execute_owner_count)
+    {
+        mach_port_t owner =
+            i386_suspended_execute_owners[--i386_suspended_execute_owner_count];
+        kern_return_t status = thread_resume( owner );
+
+        TRACE_(seh)( "Resumed Rosetta x86 execute-breakpoint owner thread=%#x status=%#x\n",
+                     owner, status );
+        if (status == KERN_SUCCESS && preferred == MACH_PORT_NULL) preferred = owner;
+    }
+    return preferred;
+}
+
+static enum i386_execute_page_owner_state suspend_i386_execute_page_owners(
+    DWORD_PTR address, int *protection )
+{
+    DWORD_PTR page = i386_execute_page( address );
+    mach_port_t current = pthread_mach_thread_np( pthread_self() );
+    unsigned int i, j;
+    BOOL found = FALSE, failed = FALSE, retired = FALSE;
+
+    if (i386_suspended_execute_owner_count)
+        return get_i386_execute_page_guard( address, protection )
+               ? I386_EXECUTE_PAGE_OWNERS_ACTIVE
+               : I386_EXECUTE_PAGE_NOT_FOUND;
+
+    lock_i386_execute_page_guards();
+    for (i = 0; i < ARRAY_SIZE(i386_execute_page_guards); ++i)
+    {
+        struct i386_execute_page_guard *guard = &i386_execute_page_guards[i];
+
+        if (guard->page != page) continue;
+        *protection = guard->protection;
+        found = TRUE;
+        discard_dead_i386_execute_page_owners( guard );
+        if (!guard->references)
+        {
+            memset( guard, 0, sizeof(*guard) );
+            retired = TRUE;
+            break;
+        }
+        for (j = 0; j < ARRAY_SIZE(guard->owners); ++j)
+        {
+            mach_port_t owner = guard->owners[j].thread;
+
+            if (!owner || owner == current) continue;
+            if (thread_suspend( owner ) != KERN_SUCCESS)
+            {
+                failed = TRUE;
+                break;
+            }
+            i386_suspended_execute_owners[i386_suspended_execute_owner_count++] = owner;
+        }
+        break;
+    }
+    unlock_i386_execute_page_guards();
+
+    if (failed)
+    {
+        WARN_(seh)( "Unable to suspend every Rosetta x86 execute-breakpoint owner for page %p\n",
+                    (void *)page );
+        resume_i386_execute_page_owners();
+        return I386_EXECUTE_PAGE_NOT_FOUND;
+    }
+    if (!found) return I386_EXECUTE_PAGE_NOT_FOUND;
+    return retired ? I386_EXECUTE_PAGE_OWNERS_RETIRED
+                   : I386_EXECUTE_PAGE_OWNERS_ACTIVE;
+}
+
+static void rearm_i386_foreign_execute_page( struct amd64_thread_data *data,
+                                             BOOL resume_owners )
+{
+    mach_port_t preferred;
+    kern_return_t status;
+    int protection;
+
+    if (!data->execute_step_foreign) return;
+    if (get_i386_execute_page_guard( data->execute_step_page, &protection ))
+        set_i386_execute_page_protection(
+            data->execute_step_page, i386_execute_guard_protection( protection ) );
+    if (!resume_owners) return;
+    preferred = resume_i386_execute_page_owners();
+    if (preferred != MACH_PORT_NULL)
+    {
+        status = thread_switch( preferred, SWITCH_OPTION_WAIT, 1 );
+        TRACE_(seh)( "Yielded Rosetta x86 execute page to owner thread=%#x status=%#x\n",
+                     preferred, status );
+    }
+}
+
+static int i386_execute_page_original_protection( DWORD_PTR address )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+        if (((data->execute_bp_active | data->execute_bp_suppressed) & (1u << i)) &&
+            i386_execute_page( i386_tracked_execute_address( data, i ) ) == page)
+            return i386_tracked_execute_protection( data, i );
+    return PROT_READ | PROT_EXEC;
+}
+
+static unsigned int i386_execute_breakpoint_page_mask( DWORD_PTR address )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i, mask = 0;
+
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+        if ((data->execute_bp_active & (1u << i)) &&
+            i386_execute_page( i386_tracked_execute_address( data, i ) ) == page)
+            mask |= 1u << i;
+    return mask;
+}
+
+static __thread DWORD i386_protected_transform_output;
+
+static void trace_i386_protected_transform_state( const I386_CONTEXT *context )
+{
+    const DWORD zombies_transform_entry = 0x009b01a0;
+    const DWORD zombies_transform_redirect = 0x009b0210;
+    const DWORD protected_followup = 0x004f8347;
+    const DWORD zombies_hash_copy = 0x00a6c847;
+    const DWORD multiplayer_hash_copy = 0x00a72c37;
+    DWORD stack[4] = {0};
+    DWORD output[4] = {0};
+    DWORD source[4] = {0};
+    DWORD destination[4] = {0};
+    const char *phase;
+    int source_protection = 0, destination_protection = 0;
+    BOOL source_mapped = FALSE, destination_mapped = FALSE;
+    SIZE_T stack_bytes = 0, output_bytes = 0;
+    SIZE_T source_bytes = 0, destination_bytes = 0;
+
+    if (!trace_i386_protected_transform) return;
+
+    if (context->Eip == zombies_transform_entry)
+        phase = "entry";
+    else if (context->Eip == zombies_transform_redirect)
+        phase = "redirect";
+    else if (context->Eip == protected_followup)
+        phase = "followup";
+    else if (context->Eip == zombies_hash_copy ||
+             context->Eip == multiplayer_hash_copy)
+        phase = "hash-fault";
+    else
+        return;
+
+    if (context->Eip == zombies_transform_entry ||
+        context->Eip == zombies_transform_redirect)
+    {
+        stack_bytes = virtual_uninterrupted_read_memory(
+            (const void *)(ULONG_PTR)context->Esp, stack, sizeof(stack) );
+        if (stack_bytes == sizeof(stack)) i386_protected_transform_output = stack[3];
+    }
+
+    if (i386_protected_transform_output)
+        output_bytes = virtual_uninterrupted_read_memory(
+            (const void *)(ULONG_PTR)i386_protected_transform_output,
+            output, sizeof(output) );
+
+    if (context->Eip == zombies_hash_copy ||
+        context->Eip == multiplayer_hash_copy)
+    {
+        source_mapped = query_i386_execute_page_protection(
+            context->Esi, &source_protection );
+        destination_mapped = query_i386_execute_page_protection(
+            context->Edi, &destination_protection );
+        source_bytes = virtual_uninterrupted_read_memory(
+            (const void *)(ULONG_PTR)context->Esi, source, sizeof(source) );
+        destination_bytes = virtual_uninterrupted_read_memory(
+            (const void *)(ULONG_PTR)context->Edi, destination,
+            sizeof(destination) );
+    }
+
+    fprintf( stderr,
+             "SECUNDA_PROTECTED_TRANSFORM phase=%s tid=%p eip=%08x esp=%08x "
+             "stack_bytes=%lu return=%08x input=%08x:%08x output_ptr=%08x "
+             "output_bytes=%lu output=%08x:%08x:%08x:%08x dr6=%08x dr7=%08x\n",
+             phase, NtCurrentTeb()->ClientId.UniqueThread, context->Eip,
+             context->Esp, (unsigned long)stack_bytes, stack[0], stack[1],
+             stack[2], i386_protected_transform_output,
+             (unsigned long)output_bytes, output[0], output[1], output[2],
+             output[3], context->Dr6, context->Dr7 );
+    if (context->Eip == zombies_hash_copy ||
+        context->Eip == multiplayer_hash_copy)
+        fprintf( stderr,
+                 "SECUNDA_PROTECTED_COPY eax=%08x ebx=%08x ecx=%08x edx=%08x "
+                 "esi=%08x edi=%08x source_bytes=%lu "
+                 "source=%08x:%08x:%08x:%08x destination_bytes=%lu "
+                 "destination=%08x:%08x:%08x:%08x source_mapped=%u "
+                 "source_protection=%x destination_mapped=%u "
+                 "destination_protection=%x\n",
+                 context->Eax, context->Ebx, context->Ecx, context->Edx,
+                 context->Esi, context->Edi, (unsigned long)source_bytes,
+                 source[0], source[1], source[2], source[3],
+                 (unsigned long)destination_bytes, destination[0],
+                 destination[1], destination[2], destination[3], source_mapped,
+                 source_protection, destination_mapped, destination_protection );
+}
+
+static void update_i386_execute_breakpoints( const I386_CONTEXT *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    unsigned int i;
+
+    arm_i386_execute_entry_observer();
+    trace_i386_protected_transform_state( context );
+
+    TRACE_(seh)( "Rosetta x86 debug update tid=%p eip=%#x esp=%#x eflags=%#x "
+                 "eax=%#x ebx=%#x ecx=%#x edx=%#x esi=%#x edi=%#x "
+                 "dr0=%#x dr1=%#x dr2=%#x dr3=%#x dr6=%#x dr7=%#x "
+                 "active=%#x suppressed=%#x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, context->Eip, context->Esp,
+                 context->EFlags, context->Eax, context->Ebx, context->Ecx,
+                 context->Edx, context->Esi, context->Edi,
+                 context->Dr0, context->Dr1,
+                 context->Dr2, context->Dr3, context->Dr6, context->Dr7,
+                 data->execute_bp_active, data->execute_bp_suppressed );
+
+    for (i = 0; i < 4; i++)
+    {
+        BYTE bit = 1u << i;
+        DWORD address = i386_debug_address( context, i );
+        DWORD_PTR old_address;
+
+        if (!(data->execute_bp_active & bit) && !(data->execute_bp_suppressed & bit))
+            continue;
+        if (i386_execute_breakpoint_enabled( context, i ) &&
+            i386_tracked_execute_address( data, i ) == address)
+            continue;
+
+        old_address = i386_tracked_execute_address( data, i );
+        data->execute_bp_active &= ~bit;
+        data->execute_bp_suppressed &= ~bit;
+        release_i386_execute_page( old_address, NtCurrentTeb() );
+        data->execute_bp[i] = 0;
+    }
+
+    for (i = 0; i < 4; i++)
+    {
+        BYTE bit = 1u << i;
+        DWORD address = i386_debug_address( context, i );
+        int protection;
+
+        if (!i386_execute_breakpoint_enabled( context, i ) ||
+            (data->execute_bp_suppressed & bit) ||
+            (data->execute_bp_active & bit))
+            continue;
+
+        if (retain_i386_execute_page( address, &protection ))
+        {
+            data->execute_bp[i] = (DWORD_PTR)address |
+                                  ((DWORD_PTR)(unsigned int)protection << 32);
+            data->execute_bp_active |= bit;
+            TRACE_(seh)( "Rosetta x86 execute breakpoint guarded tid=%p dr%u=%#x "
+                         "page=%p protection=%#x\n",
+                         NtCurrentTeb()->ClientId.UniqueThread, i, address,
+                         (void *)i386_execute_page( address ), protection );
+        }
+    }
+}
+
+static unsigned int i386_execute_breakpoint_hit_mask( const CONTEXT *context,
+                                                      ULONG_PTR address )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    const ULONG64 registers[] = {context->Dr0, context->Dr1, context->Dr2, context->Dr3};
+    unsigned int i, mask = 0;
+
+    for (i = 0; i < ARRAY_SIZE(registers); i++)
+    {
+        if (!(data->execute_bp_active & (1u << i))) continue;
+        if (!(context->Dr7 & ((ULONG64)3 << (i * 2)))) continue;
+        if ((context->Dr7 >> (16 + i * 4)) & 3) continue;
+        if (registers[i] == address &&
+            i386_tracked_execute_address( data, i ) == address)
+            mask |= 1u << i;
+    }
+    return mask;
+}
+
+static void consume_i386_execute_breakpoint( unsigned int hit_mask )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+
+    data->execute_bp_active &= ~hit_mask;
+    data->execute_bp_suppressed |= hit_mask;
+}
+
+static void enable_i386_suppressed_execute_pages( void )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    unsigned int i, j;
+
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+    {
+        DWORD_PTR address, page;
+
+        if (!(data->execute_bp_suppressed & (1u << i))) continue;
+        address = i386_tracked_execute_address( data, i );
+        page = i386_execute_page( address );
+        for (j = 0; j < i; ++j)
+            if ((data->execute_bp_suppressed & (1u << j)) &&
+                i386_execute_page( i386_tracked_execute_address( data, j ) ) == page)
+                break;
+        if (j == i)
+            set_i386_execute_page_protection(
+                address, i386_tracked_execute_protection( data, i ) );
+    }
+}
+
+static void schedule_i386_execute_breakpoint_resume( I386_CONTEXT *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+
+    if (data->execute_dispatch_pending)
+    {
+        data->execute_dispatch_pending = 0;
+        TRACE_(seh)( "Rosetta x86 execute breakpoint dispatch context retained "
+                     "tid=%p eip=%#x suppressed=%#x\n",
+                     NtCurrentTeb()->ClientId.UniqueThread, context->Eip,
+                     data->execute_bp_suppressed );
+        return;
+    }
+    if (!data->execute_bp_suppressed || data->execute_page_stepping) return;
+    enable_i386_suppressed_execute_pages();
+    data->execute_step_page = 0;
+    data->execute_step_guest_tf = !!(context->EFlags & 0x100);
+    data->execute_page_stepping = 1;
+    data->execute_step_foreign = 0;
+    context->EFlags |= 0x100;
+    TRACE_(seh)( "Rosetta x86 execute breakpoint resume scheduled tid=%p "
+                 "eip=%#x suppressed=%#x guest_tf=%u\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, context->Eip,
+                 data->execute_bp_suppressed, data->execute_step_guest_tf );
+}
+
+static void rearm_i386_execute_breakpoints( void )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    unsigned int pending = data->execute_bp_suppressed;
+    unsigned int i, j;
+
+    data->execute_bp_suppressed = 0;
+    data->execute_bp_active |= pending;
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+    {
+        DWORD_PTR address, page;
+        int protection;
+
+        if (!(pending & (1u << i))) continue;
+        address = i386_tracked_execute_address( data, i );
+        page = i386_execute_page( address );
+        for (j = 0; j < i; ++j)
+            if ((pending & (1u << j)) &&
+                i386_execute_page( i386_tracked_execute_address( data, j ) ) == page)
+                break;
+        if (j != i) continue;
+        protection = i386_tracked_execute_protection( data, i );
+        set_i386_execute_page_protection(
+            address, i386_execute_guard_protection( protection ) );
+    }
+}
+
+static BOOL complete_i386_execute_breakpoint_resume( ucontext_t *ucontext,
+                                                      CONTEXT *context,
+                                                      I386_CONTEXT *wow_context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    BOOL guest_tf = data->execute_step_guest_tf;
+
+    rearm_i386_execute_breakpoints();
+    data->execute_step_guest_tf = 0;
+    data->execute_page_stepping = 0;
+    data->execute_step_page = 0;
+    data->execute_step_foreign = 0;
+    context->EFlags &= ~0x10000;
+    EFL_sig(ucontext) &= ~0x10000;
+    if (wow_context) wow_context->EFlags &= ~0x10000;
+    if (guest_tf)
+    {
+        context->Dr6 |= 1u << 14;
+        return TRUE;
+    }
+    context->EFlags &= ~0x100;
+    EFL_sig(ucontext) &= ~0x100;
+    if (wow_context) wow_context->EFlags &= ~0x100;
+    return FALSE;
+}
+
+static void sync_i386_signal_context( I386_CONTEXT *context, const ucontext_t *ucontext )
+{
+    context->Eax = RAX_sig(ucontext);
+    context->Ebx = RBX_sig(ucontext);
+    context->Ecx = RCX_sig(ucontext);
+    context->Edx = RDX_sig(ucontext);
+    context->Esi = RSI_sig(ucontext);
+    context->Edi = RDI_sig(ucontext);
+    context->Esp = RSP_sig(ucontext);
+    context->Ebp = RBP_sig(ucontext);
+    context->Eip = RIP_sig(ucontext);
+    context->EFlags = EFL_sig(ucontext);
+}
+
+static void prepare_i386_execute_breakpoint( ucontext_t *ucontext,
+                                             EXCEPTION_RECORD *rec,
+                                             struct xcontext *context,
+                                             unsigned int hit_mask )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    I386_CONTEXT *wow_context = get_cpu_area( IMAGE_FILE_MACHINE_I386 );
+    DWORD saved_flags;
+
+    TRACE_(seh)( "Rosetta x86 execute breakpoint hit tid=%p address=%p mask=%#x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread,
+                 (void *)RIP_sig(ucontext), hit_mask );
+    rec->ExceptionCode = EXCEPTION_SINGLE_STEP;
+    rec->ExceptionAddress = (void *)RIP_sig(ucontext);
+    rec->NumberParameters = 0;
+    consume_i386_execute_breakpoint( hit_mask );
+    arm_shared_i386_execute_page_guard( RIP_sig(ucontext) );
+    data->execute_dispatch_pending = 1;
+    context->c.Dr6 = I386_DR6_BASE | hit_mask;
+    context->c.EFlags |= 0x10000;
+    EFL_sig(ucontext) |= 0x10000;
+    if (wow_context) wow_context->EFlags |= 0x10000;
+    if (!data->execute_step_guest_tf)
+    {
+        context->c.EFlags &= ~0x100;
+        EFL_sig(ucontext) &= ~0x100;
+        if (wow_context) wow_context->EFlags &= ~0x100;
+    }
+    else context->c.Dr6 |= 1u << 14;
+    data->execute_step_guest_tf = 0;
+    data->execute_page_stepping = 0;
+    data->execute_step_page = 0;
+    data->execute_step_foreign = 0;
+    saved_flags = context->c.ContextFlags;
+    context->c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    NtSetContextThread( GetCurrentThread(), &context->c );
+    context->c.ContextFlags = saved_flags;
+}
+
+static int handle_i386_execute_page_fault( ucontext_t *ucontext,
+                                           EXCEPTION_RECORD *rec,
+                                           struct xcontext *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    I386_CONTEXT *wow_context = get_cpu_area( IMAGE_FILE_MACHINE_I386 );
+    DWORD_PTR address = RIP_sig(ucontext);
+    unsigned int page_mask, hit_mask;
+    BOOL entry_captured = FALSE;
+    enum i386_execute_page_owner_state owner_state = I386_EXECUTE_PAGE_OWNERS_ACTIVE;
+    int protection;
+
+    page_mask = i386_execute_breakpoint_page_mask( address );
+    if (page_mask)
+    {
+        protection = i386_execute_page_original_protection( address );
+        entry_captured = capture_i386_execute_entry( ucontext, address );
+    }
+    else
+    {
+        owner_state = suspend_i386_execute_page_owners( address, &protection );
+        if (owner_state == I386_EXECUTE_PAGE_NOT_FOUND) return 0;
+        if (owner_state == I386_EXECUTE_PAGE_OWNERS_RETIRED)
+        {
+            if (!set_i386_execute_page_protection( address, protection )) return 0;
+            return 1;
+        }
+        entry_captured = capture_i386_execute_entry( ucontext, address );
+        if (entry_captured && !get_i386_execute_page_guard( address, &protection ))
+        {
+            resume_i386_execute_page_owners();
+            return 1;
+        }
+    }
+    get_relayed_debug_registers( &context->c );
+
+    if (wow_context) sync_i386_signal_context( wow_context, ucontext );
+    if (!data->execute_page_stepping)
+        data->execute_step_guest_tf = !!(EFL_sig(ucontext) & 0x100);
+    if (!set_i386_execute_page_protection( address, protection ))
+    {
+        if (!page_mask) resume_i386_execute_page_owners();
+        return 0;
+    }
+    data->execute_step_page = i386_execute_page( address );
+    data->execute_page_stepping = 1;
+    data->execute_step_foreign = !page_mask;
+    hit_mask = i386_execute_breakpoint_hit_mask( &context->c, address );
+    if (hit_mask)
+    {
+        prepare_i386_execute_breakpoint( ucontext, rec, context, hit_mask );
+        return 2;
+    }
+
+    TRACE_(seh)( "Rosetta x86 execute page entered tid=%p eip=%p page=%p mask=%#x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, (void *)address,
+                 (void *)data->execute_step_page, page_mask );
+    EFL_sig(ucontext) |= 0x100;
+    if (wow_context) wow_context->EFlags |= 0x100;
+    return 1;
+}
+#endif
