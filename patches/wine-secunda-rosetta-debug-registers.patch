+#ifdef __APPLE__
+static void replay_data_watchpoint_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    ucontext_t *ucontext = sigcontext;
+    struct xcontext xcontext;
+
+    (void)signal;
+    (void)siginfo;
+
+    /* The broker reserves this signal for data-watchpoint replay. Refresh the
+     * logical debug state, then execute exactly one interrupted instruction. */
+    init_handler( ucontext );
+    save_context( &xcontext, ucontext );
+    get_relayed_debug_registers( &xcontext.c );
+    EFL_sig(ucontext) |= 0x100;
+}
+#endif
