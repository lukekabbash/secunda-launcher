+
+static BOOL i386_data_breakpoint_hit_values( ULONG64 dr6, ULONG64 dr7 )
+{
+    unsigned int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        if (!(dr6 & ((ULONG64)1 << i))) continue;
+        if (!(dr7 & ((ULONG64)3 << (i * 2)))) continue;
+        if ((dr7 >> (16 + i * 4)) & 3) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL i386_data_breakpoint_hit( const CONTEXT *context )
+{
+    return i386_data_breakpoint_hit_values( context->Dr6, context->Dr7 );
