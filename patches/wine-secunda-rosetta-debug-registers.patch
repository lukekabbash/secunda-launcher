+static BOOL i386_data_breakpoint_hit( const CONTEXT *context )
+{
+    return i386_data_breakpoint_hit_values( context->Dr6, context->Dr7 );
+}
+
+static DWORD_PTR i386_execute_page( DWORD_PTR address )
+{
+    return address & ~((DWORD_PTR)page_size - 1);
+}
+
+static DWORD i386_tracked_execute_address( const struct amd64_thread_data *data,
+                                           unsigned int index )
+{
+    return data->execute_bp[index];
+}
+
+static int i386_tracked_execute_protection( const struct amd64_thread_data *data,
+                                            unsigned int index )
+{
+    return data->execute_bp[index] >> 32;
+}
+
+static BOOL query_i386_execute_page_protection( DWORD_PTR address, int *protection )
+{
+    mach_vm_address_t page = i386_execute_page( address );
+    mach_vm_address_t region = page;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t status;
+
+    status = mach_vm_region( mach_task_self(), &region, &size, VM_REGION_BASIC_INFO_64,
+                             (vm_region_info_t)&info, &count, &object );
+    if (object != MACH_PORT_NULL) mach_port_deallocate( mach_task_self(), object );
+    if (status != KERN_SUCCESS || !size || region > page || page - region >= size)
+        return FALSE;
+    *protection = info.protection;
+    return TRUE;
+}
+
+static BOOL set_i386_execute_page_protection( DWORD_PTR address, int protection )
+{
+    DWORD_PTR page = i386_execute_page( address );
+
+    if (!mprotect( (void *)page, page_size, protection )) return TRUE;
+    WARN_(seh)( "Unable to set Rosetta x86 execute-breakpoint page %p protection %#x: %s\n",
+                (void *)page, protection, strerror( errno ) );
+    return FALSE;
+}
+
+static int i386_execute_page_original_protection( DWORD_PTR address )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+        if (((data->execute_bp_active | data->execute_bp_suppressed) & (1u << i)) &&
+            i386_execute_page( i386_tracked_execute_address( data, i ) ) == page)
+            return i386_tracked_execute_protection( data, i );
+    return PROT_READ | PROT_EXEC;
+}
+
+static unsigned int i386_execute_breakpoint_page_mask( DWORD_PTR address )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    DWORD_PTR page = i386_execute_page( address );
+    unsigned int i, mask = 0;
+
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+        if ((data->execute_bp_active & (1u << i)) &&
+            i386_execute_page( i386_tracked_execute_address( data, i ) ) == page)
+            mask |= 1u << i;
+    return mask;
+}
+
+static void update_i386_execute_breakpoints( const I386_CONTEXT *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    unsigned int i;
+
+    TRACE_(seh)( "Rosetta x86 debug update tid=%p eip=%#x esp=%#x eflags=%#x "
+                 "eax=%#x ebx=%#x ecx=%#x edx=%#x esi=%#x edi=%#x "
+                 "dr0=%#x dr1=%#x dr2=%#x dr3=%#x dr6=%#x dr7=%#x "
+                 "active=%#x suppressed=%#x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, context->Eip, context->Esp,
+                 context->EFlags, context->Eax, context->Ebx, context->Ecx,
+                 context->Edx, context->Esi, context->Edi,
+                 context->Dr0, context->Dr1,
+                 context->Dr2, context->Dr3, context->Dr6, context->Dr7,
+                 data->execute_bp_active, data->execute_bp_suppressed );
+
+    for (i = 0; i < 4; i++)
+    {
+        BYTE bit = 1u << i;
+        DWORD address = i386_debug_address( context, i );
+        DWORD_PTR old_address;
+        int old_protection;
+
+        if (!(data->execute_bp_active & bit) && !(data->execute_bp_suppressed & bit))
+            continue;
+        if (i386_execute_breakpoint_enabled( context, i ) &&
+            i386_tracked_execute_address( data, i ) == address)
+            continue;
+
+        old_address = i386_tracked_execute_address( data, i );
+        old_protection = i386_tracked_execute_protection( data, i );
+        data->execute_bp_active &= ~bit;
+        data->execute_bp_suppressed &= ~bit;
+        if (!i386_execute_breakpoint_page_mask( old_address ) &&
+            (!data->execute_page_stepping ||
+             data->execute_step_page != i386_execute_page( old_address )))
+            set_i386_execute_page_protection( old_address, old_protection );
+        data->execute_bp[i] = 0;
+    }
+
+    for (i = 0; i < 4; i++)
+    {
+        BYTE bit = 1u << i;
+        DWORD address = i386_debug_address( context, i );
+        int protection;
+
+        if (!i386_execute_breakpoint_enabled( context, i ) ||
+            (data->execute_bp_suppressed & bit) ||
+            (data->execute_bp_active & bit))
+            continue;
+
+        if (query_i386_execute_page_protection( address, &protection ) &&
+            (protection & PROT_EXEC) &&
+            set_i386_execute_page_protection( address, protection & ~PROT_EXEC ))
+        {
+            data->execute_bp[i] = (DWORD_PTR)address |
+                                  ((DWORD_PTR)(unsigned int)protection << 32);
+            data->execute_bp_active |= bit;
+            TRACE_(seh)( "Rosetta x86 execute breakpoint guarded tid=%p dr%u=%#x "
+                         "page=%p protection=%#x\n",
+                         NtCurrentTeb()->ClientId.UniqueThread, i, address,
+                         (void *)i386_execute_page( address ), protection );
+        }
+    }
+}
+
+static unsigned int i386_execute_breakpoint_hit_mask( const CONTEXT *context,
+                                                      ULONG_PTR address )
+{
+    const struct amd64_thread_data *data = amd64_thread_data();
+    const ULONG64 registers[] = {context->Dr0, context->Dr1, context->Dr2, context->Dr3};
+    unsigned int i, mask = 0;
+
+    for (i = 0; i < ARRAY_SIZE(registers); i++)
+    {
+        if (!(data->execute_bp_active & (1u << i))) continue;
+        if (!(context->Dr7 & ((ULONG64)3 << (i * 2)))) continue;
+        if ((context->Dr7 >> (16 + i * 4)) & 3) continue;
+        if (registers[i] == address &&
+            i386_tracked_execute_address( data, i ) == address)
+            mask |= 1u << i;
+    }
+    return mask;
+}
+
+static void consume_i386_execute_breakpoint( unsigned int hit_mask )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+
+    data->execute_bp_active &= ~hit_mask;
+    data->execute_bp_suppressed |= hit_mask;
+}
+
+static void schedule_i386_execute_breakpoint_resume( I386_CONTEXT *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+
+    if (data->execute_dispatch_pending)
+    {
+        data->execute_dispatch_pending = 0;
+        TRACE_(seh)( "Rosetta x86 execute breakpoint dispatch context retained "
+                     "tid=%p eip=%#x suppressed=%#x\n",
+                     NtCurrentTeb()->ClientId.UniqueThread, context->Eip,
+                     data->execute_bp_suppressed );
+        return;
+    }
+    if (!data->execute_bp_suppressed || data->execute_page_stepping) return;
+    data->execute_step_page = 0;
+    data->execute_step_guest_tf = !!(context->EFlags & 0x100);
+    data->execute_page_stepping = 1;
+    context->EFlags |= 0x100;
+    TRACE_(seh)( "Rosetta x86 execute breakpoint resume scheduled tid=%p "
+                 "eip=%#x suppressed=%#x guest_tf=%u\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, context->Eip,
+                 data->execute_bp_suppressed, data->execute_step_guest_tf );
+}
+
+static void rearm_i386_execute_breakpoints( void )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    unsigned int pending = data->execute_bp_suppressed;
+    unsigned int i, j;
+
+    data->execute_bp_suppressed = 0;
+    data->execute_bp_active |= pending;
+    for (i = 0; i < ARRAY_SIZE(data->execute_bp); ++i)
+    {
+        DWORD_PTR address, page;
+        int protection;
+
+        if (!(pending & (1u << i))) continue;
+        address = i386_tracked_execute_address( data, i );
+        page = i386_execute_page( address );
+        for (j = 0; j < i; ++j)
+            if ((pending & (1u << j)) &&
+                i386_execute_page( i386_tracked_execute_address( data, j ) ) == page)
+                break;
+        if (j != i) continue;
+        protection = i386_tracked_execute_protection( data, i );
+        set_i386_execute_page_protection( address, protection & ~PROT_EXEC );
+    }
+}
+
+static BOOL complete_i386_execute_breakpoint_resume( ucontext_t *ucontext,
+                                                      CONTEXT *context,
+                                                      I386_CONTEXT *wow_context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    BOOL guest_tf = data->execute_step_guest_tf;
+
+    rearm_i386_execute_breakpoints();
+    data->execute_step_guest_tf = 0;
+    data->execute_page_stepping = 0;
+    data->execute_step_page = 0;
+    context->EFlags &= ~0x10000;
+    EFL_sig(ucontext) &= ~0x10000;
+    if (wow_context) wow_context->EFlags &= ~0x10000;
+    if (guest_tf)
+    {
+        context->Dr6 |= 1u << 14;
+        return TRUE;
+    }
+    context->EFlags &= ~0x100;
+    EFL_sig(ucontext) &= ~0x100;
+    if (wow_context) wow_context->EFlags &= ~0x100;
+    return FALSE;
+}
+
+static void sync_i386_signal_context( I386_CONTEXT *context, const ucontext_t *ucontext )
+{
+    context->Eax = RAX_sig(ucontext);
+    context->Ebx = RBX_sig(ucontext);
+    context->Ecx = RCX_sig(ucontext);
+    context->Edx = RDX_sig(ucontext);
+    context->Esi = RSI_sig(ucontext);
+    context->Edi = RDI_sig(ucontext);
+    context->Esp = RSP_sig(ucontext);
+    context->Ebp = RBP_sig(ucontext);
+    context->Eip = RIP_sig(ucontext);
+    context->EFlags = EFL_sig(ucontext);
+}
+
+static void prepare_i386_execute_breakpoint( ucontext_t *ucontext,
+                                             EXCEPTION_RECORD *rec,
+                                             struct xcontext *context,
+                                             unsigned int hit_mask )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    I386_CONTEXT *wow_context = get_cpu_area( IMAGE_FILE_MACHINE_I386 );
+    DWORD saved_flags;
+
+    TRACE_(seh)( "Rosetta x86 execute breakpoint hit tid=%p address=%p mask=%#x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread,
+                 (void *)RIP_sig(ucontext), hit_mask );
+    rec->ExceptionCode = EXCEPTION_SINGLE_STEP;
+    rec->ExceptionAddress = (void *)RIP_sig(ucontext);
+    rec->NumberParameters = 0;
+    consume_i386_execute_breakpoint( hit_mask );
+    data->execute_dispatch_pending = 1;
+    context->c.Dr6 = I386_DR6_BASE | hit_mask;
+    context->c.EFlags |= 0x10000;
+    EFL_sig(ucontext) |= 0x10000;
+    if (wow_context) wow_context->EFlags |= 0x10000;
+    if (!data->execute_step_guest_tf)
+    {
+        context->c.EFlags &= ~0x100;
+        EFL_sig(ucontext) &= ~0x100;
+        if (wow_context) wow_context->EFlags &= ~0x100;
+    }
+    else context->c.Dr6 |= 1u << 14;
+    data->execute_step_guest_tf = 0;
+    data->execute_page_stepping = 0;
+    data->execute_step_page = 0;
+    saved_flags = context->c.ContextFlags;
+    context->c.ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    NtSetContextThread( GetCurrentThread(), &context->c );
+    context->c.ContextFlags = saved_flags;
+}
+
+static int handle_i386_execute_page_fault( ucontext_t *ucontext,
+                                           EXCEPTION_RECORD *rec,
+                                           struct xcontext *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    I386_CONTEXT *wow_context = get_cpu_area( IMAGE_FILE_MACHINE_I386 );
+    DWORD_PTR address = RIP_sig(ucontext);
+    unsigned int page_mask, hit_mask;
+
+    if (!data->execute_bp_active) return 0;
+    get_relayed_debug_registers( &context->c );
+    page_mask = i386_execute_breakpoint_page_mask( address );
+    if (!page_mask) return 0;
+    if (!set_i386_execute_page_protection( address,
+                                           i386_execute_page_original_protection( address ) ))
+        return 0;
+
+    if (wow_context) sync_i386_signal_context( wow_context, ucontext );
+    data->execute_step_page = i386_execute_page( address );
+    data->execute_step_guest_tf = !!(EFL_sig(ucontext) & 0x100);
+    data->execute_page_stepping = 1;
+    hit_mask = i386_execute_breakpoint_hit_mask( &context->c, address );
+    if (hit_mask)
+    {
+        prepare_i386_execute_breakpoint( ucontext, rec, context, hit_mask );
+        return 2;
+    }
+
+    TRACE_(seh)( "Rosetta x86 execute page entered tid=%p eip=%p page=%p mask=%#x\n",
+                 NtCurrentTeb()->ClientId.UniqueThread, (void *)address,
+                 (void *)data->execute_step_page, page_mask );
+    EFL_sig(ucontext) |= 0x100;
+    if (wow_context) wow_context->EFlags |= 0x100;
+    return 1;
+}
