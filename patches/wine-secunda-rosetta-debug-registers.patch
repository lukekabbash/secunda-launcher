+static BOOL get_relayed_debug_registers( CONTEXT *context )
+{
+#ifdef __APPLE__
+    DWORD saved_flags;
+
+    saved_flags = context->ContextFlags;
+    context->ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    if (NtGetContextThread( GetCurrentThread(), context ))
+    {
+        context->ContextFlags = saved_flags;
+        return FALSE;
+    }
