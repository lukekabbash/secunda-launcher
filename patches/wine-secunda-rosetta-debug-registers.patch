+static __thread DWORD_PTR i386_protected_hash_copy_page;
+
+static BOOL read_i386_protected_hash_memory( DWORD address, void *destination,
+                                             SIZE_T size, int *original_protection )
+{
+    if ((address & (page_size - 1)) + size > page_size ||
+        !query_i386_execute_page_protection( address, original_protection ) ||
+        *original_protection != PROT_NONE ||
+        !set_i386_execute_page_protection( address, PROT_READ ))
+        return FALSE;
+
+    memcpy( destination, (const void *)(ULONG_PTR)address, size );
+    if (set_i386_execute_page_protection( address, *original_protection )) return TRUE;
+
+    ERR_(seh)( "Unable to restore protected hash page at %08x\n", address );
+    return FALSE;
+}
