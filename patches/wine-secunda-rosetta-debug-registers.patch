+            response.reply.magic != SECUNDA_DEBUG_MAGIC)
+            result = KERN_INVALID_ARGUMENT;
+        else
+        {
+            result = response.reply.status;
+            if (result == KERN_SUCCESS) *registers = response.reply.registers;
+        }
+    }
+done:
+    mach_port_deallocate( mach_task_self(), reply_port );
+    return result;
+}
