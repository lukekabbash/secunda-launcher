+#ifndef __WINE_SERVER_SECUNDA_DEBUG_H
+#define __WINE_SERVER_SECUNDA_DEBUG_H
+
+#include <mach/mach.h>
+#include <stdint.h>
+
+#define SECUNDA_DEBUG_HELLO_ID 0x53440001
+#define SECUNDA_DEBUG_SET_ID   0x53440002
+#define SECUNDA_DEBUG_GET_ID   0x53440003
+#define SECUNDA_DEBUG_REPLY_ID 0x53440004
+#define SECUNDA_DEBUG_MAGIC    0x53444344u
+
+/* A new debug exception reports only its current B0-B3 hit bits. Keep the
+ * architecturally fixed DR6 bits visible to translated Windows code. */
+#define SECUNDA_DEBUG_DR6_BASE UINT64_C(0xffff0ff0)
+
+/* The native relay uses a non-architectural 64-bit DR6 bit to identify the
+ * trace completion of a replayed data watchpoint. It is stripped before a
+ * Windows context is dispatched and truncates naturally from WOW64 state. */
+#define SECUNDA_DEBUG_DATA_REPLAY (UINT64_C(1) << 63)
+
+struct secunda_debug_registers
+{
+    uint64_t dr[8];
+};
+
+struct secunda_debug_hello
+{
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t command_port;
+    uint32_t magic;
+};
+
+struct secunda_debug_command
+{
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t thread_port;
+    uint32_t magic;
+    uint32_t thread_id;
+    int32_t unix_pid;
+    int32_t unix_tid;
+    uint16_t machine;
+    uint16_t reserved;
+    struct secunda_debug_registers registers;
+};
+
+struct secunda_debug_reply
+{
+    mach_msg_header_t header;
+    uint32_t magic;
+    kern_return_t status;
+    struct secunda_debug_registers registers;
+};
+
+#endif
