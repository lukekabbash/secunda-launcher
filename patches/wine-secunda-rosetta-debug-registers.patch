+static BOOL query_i386_execute_page_protection( DWORD_PTR address, int *protection )
+{
+    mach_vm_address_t page = i386_execute_page( address );
+    mach_vm_address_t region = page;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    kern_return_t status;
+
+    status = mach_vm_region( mach_task_self(), &region, &size, VM_REGION_BASIC_INFO_64,
+                             (vm_region_info_t)&info, &count, &object );
+    if (object != MACH_PORT_NULL) mach_port_deallocate( mach_task_self(), object );
+    if (status != KERN_SUCCESS || !size || region > page || page - region >= size)
+        return FALSE;
+    *protection = info.protection;
+    return TRUE;
+}
+
+static BOOL set_i386_execute_page_protection( DWORD_PTR address, int protection )
+{
+    DWORD_PTR page = i386_execute_page( address );
+
+    if (!mprotect( (void *)page, page_size, protection )) return TRUE;
+    WARN_(seh)( "Unable to set Rosetta x86 execute-breakpoint page %p protection %#x: %s\n",
+                (void *)page, protection, strerror( errno ) );
+    return FALSE;
+}
