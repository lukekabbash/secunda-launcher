+static int context_to_debug_registers( const struct context_data *context,
+                                       struct secunda_debug_registers *registers )
+{
+    memset( registers, 0, sizeof(*registers) );
+    switch (context->machine)
+    {
+    case IMAGE_FILE_MACHINE_I386:
+        registers->dr[0] = context->debug.i386_regs.dr0;
+        registers->dr[1] = context->debug.i386_regs.dr1;
+        registers->dr[2] = context->debug.i386_regs.dr2;
+        registers->dr[3] = context->debug.i386_regs.dr3;
+        registers->dr[6] = context->debug.i386_regs.dr6;
+        registers->dr[7] = context->debug.i386_regs.dr7;
+        return 1;
+    case IMAGE_FILE_MACHINE_AMD64:
+        registers->dr[0] = context->debug.x86_64_regs.dr0;
+        registers->dr[1] = context->debug.x86_64_regs.dr1;
+        registers->dr[2] = context->debug.x86_64_regs.dr2;
+        registers->dr[3] = context->debug.x86_64_regs.dr3;
+        registers->dr[6] = context->debug.x86_64_regs.dr6;
+        registers->dr[7] = context->debug.x86_64_regs.dr7;
+        return 1;
+    }
+    return 0;
+}
+
+static int debug_registers_to_context( const struct secunda_debug_registers *registers,
+                                       struct context_data *context )
+{
+    switch (context->machine)
+    {
+    case IMAGE_FILE_MACHINE_I386:
+        context->debug.i386_regs.dr0 = registers->dr[0];
+        context->debug.i386_regs.dr1 = registers->dr[1];
+        context->debug.i386_regs.dr2 = registers->dr[2];
+        context->debug.i386_regs.dr3 = registers->dr[3];
+        context->debug.i386_regs.dr6 = registers->dr[6];
+        context->debug.i386_regs.dr7 = registers->dr[7];
+        return 1;
+    case IMAGE_FILE_MACHINE_AMD64:
+        context->debug.x86_64_regs.dr0 = registers->dr[0];
+        context->debug.x86_64_regs.dr1 = registers->dr[1];
+        context->debug.x86_64_regs.dr2 = registers->dr[2];
+        context->debug.x86_64_regs.dr3 = registers->dr[3];
+        context->debug.x86_64_regs.dr6 = registers->dr[6];
+        context->debug.x86_64_regs.dr7 = registers->dr[7];
+        return 1;
+    }
+    return 0;
+}
