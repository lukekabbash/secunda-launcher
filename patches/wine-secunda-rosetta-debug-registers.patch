+static BOOL get_relayed_debug_registers( CONTEXT *context )
+{
+#ifdef __APPLE__
+    DWORD saved_flags;
+
+    saved_flags = context->ContextFlags;
+    context->ContextFlags = CONTEXT_DEBUG_REGISTERS;
+    if (NtGetContextThread( GetCurrentThread(), context ))
+    {
+        context->ContextFlags = saved_flags;
+        return FALSE;
+    }
+    context->ContextFlags |= saved_flags;
+    return TRUE;
+#else
+    return FALSE;
+#endif
+}
+
+static BOOL is_relayed_debug_trap( ucontext_t *ucontext, CONTEXT *context )
+{
+#ifdef __APPLE__
+    if (TRAP_sig(ucontext) != 0xde) return FALSE;
+    if (!get_relayed_debug_registers( context )) return FALSE;
+    return !!(context->Dr6 & 0xf);
+#endif
+    return FALSE;
+}
