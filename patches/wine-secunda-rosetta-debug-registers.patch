+        struct secunda_debug_reply reply;
+        mach_msg_trailer_t trailer;
+    } response;
+    mach_msg_type_name_t type;
+    mach_port_t process_port = get_process_port( thread->process );
+    mach_port_t reply_port, thread_port;
+    kern_return_t result;
