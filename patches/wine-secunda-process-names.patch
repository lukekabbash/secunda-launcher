--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -694,6 +694,42 @@
 
 /* CW HACK 22144 */
 #ifdef __APPLE__
+/* Secunda: the launcher publishes readable names for the programs it knows
+ * as SECUNDA_PROCESS_NAMES="image.exe=Display Name|other.exe=Other Name".
+ * Images are matched case-insensitively, with or without their extension;
+ * the first match wins.
+ */
+static char *secunda_process_display_name(const char *exe_name, size_t stem_len)
+{
+    const char *table = getenv("SECUNDA_PROCESS_NAMES");
+    size_t full_len = strlen(exe_name);
+
+    while (table && *table)
+    {
+        const char *entry_end = strchr(table, '|');
+        const char *equals;
+        size_t entry_len = entry_end ? (size_t)(entry_end - table) : strlen(table);
+
+        if ((equals = memchr(table, '=', entry_len)))
+        {
+            size_t key_len = equals - table;
+            size_t value_len = entry_len - key_len - 1;
+
+            if (value_len &&
+                ((key_len == full_len && !strncasecmp(table, exe_name, key_len)) ||
+                 (key_len == stem_len && !strncasecmp(table, exe_name, key_len))))
+            {
+                char *p, *ret = strndup(equals + 1, value_len);
+                /* The name becomes a file name: keep path separators out of it. */
+                for (p = ret; p && *p; p++) if (*p == '/' || *p == ':') *p = '-';
+                return ret;
+            }
+        }
+        table = entry_end ? entry_end + 1 : NULL;
+    }
+    return NULL;
+}
+
 /* This is the same "exe path to display name" algorithm used in
  * loader/main.c to determine the name used for the application menu (CW hack 13438).
  *
@@ -718,10 +754,12 @@
     else
         exe_name_len = strlen(exe_name);
 
