+     * without its extension ("steam" rather than "steam.exe"). */
+    if (!exe_name_len)
         ret = NULL;
+    else if (!(ret = secunda_process_display_name(exe_name, exe_name_len)))
+        ret = strndup(exe_name, exe_name_len);
 
     free(exe_path_copy);
