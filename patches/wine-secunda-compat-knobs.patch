+static BOOL image_name_matches( const UNICODE_STRING *name, const char *basename )
+{
+    SIZE_T basename_len = strlen( basename );
+    SIZE_T name_len = name->Length / sizeof(WCHAR);
+    const WCHAR *suffix;
+    SIZE_T i;
 
+    if (!basename_len || basename_len > name_len) return FALSE;
+    suffix = name->Buffer + name_len - basename_len;
+    if (suffix != name->Buffer && suffix[-1] != '\\' && suffix[-1] != '/') return FALSE;
+
+    for (i = 0; i < basename_len; ++i)
+    {
+        WCHAR left = suffix[i];
+        unsigned char right = basename[i];
+
+        if (left >= 'A' && left <= 'Z') left += 'a' - 'A';
+        if (right >= 'A' && right <= 'Z') right += 'a' - 'A';
+        if (left != right) return FALSE;
+    }
+    return TRUE;
+}
