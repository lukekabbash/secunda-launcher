+// Secunda: DXMT_AIRCONV_PRECISE=1 translates every shader without fast-math
+// flags, as if each instruction carried the precise modifier. Skyrim SE's
+// exterior shadows show a camera-following dark patch under the default
+// reassociation and approximations.
+static bool
+PreciseMathRequested() {
+  static const bool requested = [] {
+    const char *value = std::getenv("DXMT_AIRCONV_PRECISE");
+    return value && value[0] == '1';
+  }();
+  return requested;
+}
+
 std::unique_ptr<llvm::IRBuilder<>::FastMathFlagGuard>
 Converter::UseFastMath(bool OptOut) {
-  if (OptOut)
+  if (OptOut || PreciseMathRequested())
     return nullptr;
   auto Guard = std::make_unique<llvm::IRBuilder<>::FastMathFlagGuard>(ir);
   llvm::FastMathFlags FMF;
