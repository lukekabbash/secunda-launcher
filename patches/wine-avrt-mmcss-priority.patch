+/* Real MMCSS scheduling doesn't exist here, but apps that call this API
+ * (native XAudio2 among them) depend on their audio thread actually being
+ * scheduled promptly, or their own buffer-refill deadline is missed and
+ * playing sources glitch/restart. Approximate it with the same time-critical
+ * priority Wine's own mmdevapi mixer thread already relies on
+ * (dlls/mmdevapi/client.c), instead of silently doing nothing. */
+struct avrt_handle
+{
+    HANDLE thread;
+    DWORD prev_priority;
+};
+
+static int win32_priority_from_avrt(AVRT_PRIORITY prio)
+{
+    switch (prio)
+    {
+        case AVRT_PRIORITY_VERYLOW:  return THREAD_PRIORITY_LOWEST;
+        case AVRT_PRIORITY_LOW:      return THREAD_PRIORITY_BELOW_NORMAL;
+        case AVRT_PRIORITY_NORMAL:   return THREAD_PRIORITY_NORMAL;
+        case AVRT_PRIORITY_HIGH:     return THREAD_PRIORITY_HIGHEST;
+        case AVRT_PRIORITY_CRITICAL: return THREAD_PRIORITY_TIME_CRITICAL;
+        default:                     return THREAD_PRIORITY_NORMAL;
+    }
+}
+
