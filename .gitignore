.DS_Store
.build/
build/
.swiftpm/
# Generated packaging output: the Finder app, DMGs, checksums, and staging
# directories. Build these locally with the packaging scripts; do not vendor
# rebuilt Wine runtimes or ad-hoc app bundles in Git.
dist/
/Runtime/
*.xcuserstate

# CodeWeavers compliance source drop. Kept locally as build input, not vendored
# into the launcher repository.
sources/

# Managed bottles, downloaded installers, logs, and user data never belong in Git.
Secunda Data/

# Editor, OS, and tool droppings.
*.swp
*~
.idea/
.vscode/
xcuserdata/
DerivedData/
.claude/

# Local secrets and signing material. Sparkle's private key lives in the
# login keychain, never in the repository.
.env
.env.*
*.pem
*.p12
*.key

# Release artifacts and logs produced by local runs.
*.dmg
*.dmg.sha256
*.log
*.ips

# Website tooling output, if a deploy tool is ever pointed at site/.
node_modules/
.vercel/
.netlify/
