.DS_Store
.build/
build/
.swiftpm/
# Keep the runnable macOS test bundle in Git LFS while excluding generated
# DMGs, checksums, staging directories, and any future distribution output.
dist/*
!dist/Secunda Launcher.app/
!dist/Secunda Launcher.app/**
/Runtime/
*.xcuserstate

# CodeWeavers compliance source drop. Kept locally as build input, not vendored
# into the launcher repository.
sources/

# Managed bottles, downloaded installers, logs, and user data never belong in Git.
Secunda Data/
